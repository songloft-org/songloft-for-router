msgid "SongLoft"
msgstr "SongLoft 音乐服务"

msgid "SongLoft is a lightweight self-hosted music server."
msgstr "SongLoft 是一款轻量级自建音乐服务，支持本地音乐管理、网络歌曲、电台及歌单等功能。"

msgid "Project Homepage"
msgstr "项目主页"

msgid "Basic Settings"
msgstr "基础设置"

msgid "Enable"
msgstr "启用"

msgid "Status and actions"
msgstr "状态与操作"

msgid "Current status"
msgstr "当前状态"

msgid "Service control"
msgstr "服务控制"

msgid "Start"
msgstr "启动"

msgid "Stop"
msgstr "停止"

msgid "Restart"
msgstr "重启"

msgid "Open"
msgstr "打开"

msgid "Service actions use saved settings without changing Enable. Save & Apply starts or stops the service according to Enable."
msgstr "服务操作使用已保存的设置，不改变启用开关。“保存并应用”根据启用开关启动或停止服务。"

msgid "Applying the service settings failed. Check the executable, data directory and system log."
msgstr "应用服务设置失败。请检查可执行程序、数据目录和系统日志。"

msgid "Unable to read service status."
msgstr "无法读取服务状态。"

msgid "Service operation failed. Check the executable, configuration and system log."
msgstr "服务操作失败，请检查可执行程序、配置和系统日志。"

msgid "Listening Port"
msgstr "监听端口"

msgid "Data Directory"
msgstr "数据目录"

msgid "Choose a writable persistent directory before enabling SongLoft. SongLoft stores its data here and reads music from the music subdirectory. To use an existing music folder, bind mount it to this subdirectory before starting the service."
msgstr "启用 SongLoft 前请选择可写的持久化数据目录。SongLoft 在此存储数据，并从其 music 子目录读取音乐。使用已有音乐文件夹时，请在启动服务前将其绑定挂载到该子目录。"

msgid "Enter an absolute path for the data directory"
msgstr "请填写数据目录的绝对路径"

msgid "URL Base Path"
msgstr "URL 基础路径"

msgid "Used when SongLoft is served behind a reverse proxy under a sub-path, e.g. /songloft"
msgstr "当 SongLoft 通过反向代理以子路径方式提供服务时使用，例如：/songloft"

msgid "Admin Username"
msgstr "管理员用户名"

msgid "Admin Password"
msgstr "管理员密码"

msgid "Leave empty to keep the current setting unchanged"
msgstr "留空则保持当前设置不变"

msgid "Binary Path"
msgstr "程序路径"

msgid "Leave empty to use the default path /usr/bin/songloft"
msgstr "留空则使用默认路径 /usr/bin/songloft"

msgid "Web UI Directory"
msgstr "Web 界面目录"

msgid "Leave empty to use the default embedded web UI directory"
msgstr "留空则使用默认内置 Web 界面目录"

msgid "Collecting data..."
msgstr "正在获取数据..."

msgid "Running"
msgstr "运行中"

msgid "Stopped"
msgstr "已停止"

msgid "Not enabled"
msgstr "未启用"

msgid "Running (not enabled)"
msgstr "运行中（未启用）"

msgid "The service is not running"
msgstr "服务当前未运行"

msgid "PID: %s"
msgstr "PID：%s"

msgid "Logs"
msgstr "日志"

msgid "Runtime log"
msgstr "运行日志"

msgid "Refresh"
msgstr "刷新"

msgid "Shows the most recently modified regular file in data/logs under the saved data directory, regardless of its name. Large logs show only the last 128 KiB."
msgstr "显示已保存的数据目录下 data/logs 中最后修改的普通文件，不依赖文件名。较大的日志仅显示末尾 128 KiB。"

msgid "Last modified: %s"
msgstr "最后修改：%s"

msgid "The latest log file is empty."
msgstr "最新日志文件为空。"

msgid "Showing only the last 128 KiB of this file."
msgstr "仅显示此文件末尾 128 KiB。"

msgid "Unable to read the latest log file. Please refresh and try again."
msgstr "无法读取最新日志文件，请刷新后重试。"

msgid "Configure and save the data directory first."
msgstr "请先配置并保存数据目录。"

msgid "The log directory does not exist yet."
msgstr "日志目录尚不存在。"

msgid "Unable to read the log directory."
msgstr "无法读取日志目录。"

msgid "No log files found."
msgstr "未找到日志文件。"