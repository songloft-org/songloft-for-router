msgid "SongLoft"
msgstr "SongLoft 音乐服务"

msgid "SongLoft is a lightweight self-hosted music server."
msgstr "SongLoft 是一款轻量级自建音乐服务，支持本地音乐管理、网络歌曲、电台及歌单等功能。"

msgid "Project Homepage"
msgstr "项目主页"

msgid "Basic Settings"
msgstr "基础设置"

msgid "Start on boot"
msgstr "开机自启"

msgid "Service status"
msgstr "服务状态"

msgid "Service control"
msgstr "服务控制"

msgid "Start"
msgstr "启动"

msgid "Stop"
msgstr "停止"

msgid "Restart"
msgstr "重启"

msgid "Open"
msgstr "打开"

msgid "Save & Apply before starting or restarting."
msgstr "启动或重启前请先保存并应用配置。"

msgid "Unable to read service status."
msgstr "无法读取服务状态。"

msgid "Service operation failed. Check the executable, configuration and system log."
msgstr "服务操作失败，请检查可执行程序、配置和系统日志。"

msgid "Listening Port"
msgstr "监听端口"

msgid "Data Directory"
msgstr "数据目录"

msgid "Choose a writable persistent directory before enabling SongLoft. SongLoft stores its data here and reads music from the music subdirectory. To use an existing music folder, bind mount it to this subdirectory before starting the service."
msgstr "启用 SongLoft 前请选择可写的持久化数据目录。SongLoft 在此存储数据，并从其 music 子目录读取音乐。使用已有音乐文件夹时，请在启动服务前将其绑定挂载到该子目录。"

msgid "Enter an absolute path for the data directory"
msgstr "请填写数据目录的绝对路径"

msgid "URL Base Path"
msgstr "URL 基础路径"

msgid "Used when SongLoft is served behind a reverse proxy under a sub-path, e.g. /songloft"
msgstr "当 SongLoft 通过反向代理以子路径方式提供服务时使用，例如：/songloft"

msgid "Admin Username"
msgstr "管理员用户名"

msgid "Admin Password"
msgstr "管理员密码"

msgid "Leave empty to keep the current setting unchanged"
msgstr "留空则保持当前设置不变"

msgid "Binary Path"
msgstr "程序路径"

msgid "Leave empty to use the default path /usr/bin/songloft"
msgstr "留空则使用默认路径 /usr/bin/songloft"

msgid "Web UI Directory"
msgstr "Web 界面目录"

msgid "Leave empty to use the default embedded web UI directory"
msgstr "留空则使用默认内置 Web 界面目录"

msgid "Collecting data..."
msgstr "正在获取数据..."

msgid "SongLoft RUNNING"
msgstr "SongLoft 运行中"

msgid "SongLoft NOT RUNNING"
msgstr "SongLoft 未运行"