#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# Copyright (C) 2026 songloft-for-router contributors

START=99
STOP=10

USE_PROCD=1

PROG_DEFAULT=/usr/bin/songloft
WEB_DEFAULT=/usr/share/songloft/web-embedded

LOGGER="logger -t songloft"

start_instance() {
	local cfg="$1"
	local bin web

	# Do not use uci_load_validate here: its fourth argument is an eval callback,
	# and that API is not available with identical semantics on all supported
	# OpenWrt releases. config_get works on both opkg and apk based systems.
	config_get_bool enabled "$cfg" enabled 0
	config_get listen_port "$cfg" listen_port 58091
	config_get db_path "$cfg" db_path /etc/songloft/data
	config_get base_path "$cfg" base_path
	config_get admin_username "$cfg" admin_username
	config_get admin_password "$cfg" admin_password
	config_get bin_path "$cfg" bin_path
	config_get web_path "$cfg" web_path

	[ "$enabled" = "1" ] || return 0

	bin="${bin_path:-$PROG_DEFAULT}"
	web="${web_path:-$WEB_DEFAULT}"

	if [ ! -x "$bin" ]; then
		${LOGGER} "未找到可执行文件：$bin"
		return 1
	fi

	if ! mkdir -p "$db_path" "$db_path/music"; then
		${LOGGER} "无法创建工作目录或音乐目录：$db_path"
		return 1
	fi

	procd_open_instance "songloft.$cfg"
	# procd has no cwd parameter. Start through a shell so SongLoft resolves its
	# relative data/ and music/ directories below the configured work directory.
	procd_set_param command /bin/sh -c 'cd "$1" || exit 1; exec "$2"' songloft "$db_path" "$bin"

	procd_set_param env LISTEN_PORT="$listen_port"
	[ -n "$base_path" ] && procd_append_param env BASE_PATH="$base_path"
	[ -n "$admin_username" ] && procd_append_param env ADMIN_USERNAME="$admin_username"
	[ -n "$admin_password" ] && procd_append_param env ADMIN_PASSWORD="$admin_password"
	[ -d "$web" ] && procd_append_param env WEB_ROOT="$web"

	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load songloft
	config_foreach start_instance songloft
}

stop_service() {
	:
}

service_triggers() {
	procd_add_reload_trigger "songloft"
}

reload_service() {
	stop
	start
}
